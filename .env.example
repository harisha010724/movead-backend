# Copy to .env for local development. Every variable has a working default for
# the docker-compose stack, so an empty .env is enough to boot.
#
# Validated by src/shared/config.ts at startup — a malformed value stops the
# process immediately rather than surfacing later as an undefined.

NODE_ENV=development
LOG_LEVEL=debug
APP_VERSION=0.0.0-dev

# ---------------------------------------------------------------------- http
# 8080 is what movead-mobile's `npm run api:pull` expects.
API_PORT=8080
INGESTION_PORT=8081

# Locally both products share http://localhost:5173 (advertisers at /, operations
# at /admin). Production still uses two origins. 5174 is kept so an old split
# Vite preview is not blocked.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:8081

# Where each portal lives, for links the server puts in an email. An invitation
# is triggered from the admin console but has to point at the advertiser tree.
PORTAL_ADVERTISER_URL=http://localhost:5173
PORTAL_ADMIN_URL=http://localhost:5173/admin
PORTAL_DRIVER_URL=http://localhost:5173/driver

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Swagger UI at /docs. Defaults to on outside production; leave it off in
# production, where the spec is a map of the surface for anyone who asks.
DOCS_ENABLED=true

# ------------------------------------------------------------------ postgres
DATABASE_URL=postgres://movead:movead@localhost:5432/movead
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=0
# Logs every statement. Useful when tuning, deafening otherwise.
DATABASE_LOG_SQL=false

# --------------------------------------------------------------------- redis
REDIS_URL=redis://localhost:6379

# ---------------------------------------------------------------------- auth
# Minimum 32 characters. Left unset here on purpose: config.ts falls back to a
# clearly-marked development value, and refuses that fallback when NODE_ENV is
# production, so a deploy without real secrets fails to start rather than
# running insecure. Setting these to an empty string fails validation.
JWT_ISSUER=movead
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# Fifteen minutes, per architecture Part 12.1.
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=5184000

# Encrypts TOTP secrets at rest. Stands in for the KMS data key; rotating it
# invalidates every enrolled authenticator, so treat it as a real secret.
# TOTP_ENCRYPTION_KEY=
TOTP_ISSUER=MoveAd

# Set false to sign admins in on the password alone, skipping both enrolment and
# the code. A build-time convenience while the portal screens are in progress —
# the server refuses to start with this false in production.
ADMIN_MFA_REQUIRED=true

# Web portal sessions. Admin idles out sooner than advertiser; both end at the
# absolute ceiling however busy they have been.
ADMIN_IDLE_TIMEOUT_MINUTES=30
ADVERTISER_IDLE_TIMEOUT_MINUTES=120
SESSION_ABSOLUTE_HOURS=12

# Account lockout on repeated sign-in failures. Not specified by the ACs.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# ----------------------------------------------------------------- invitations
# An advertiser is never sent a password. They get a single-use link and choose
# their own; this is how long that link lasts. Long enough to survive a weekend,
# short enough that one left in an abandoned mailbox stops working.
INVITATION_TTL_HOURS=72

# ----------------------------------------------------------------------- mail
# `file` renders each message to MAIL_PREVIEW_DIR and logs the path instead of
# sending it, so templates can be designed without an SMTP server. Refused in
# production — mail that silently lands in a directory looks exactly like mail
# that was sent. Use `npm run mail:preview` to render the templates on demand.
#
# Read once at startup: switching this needs dev:api restarted, since tsx watch
# reloads source and not environment.
MAIL_TRANSPORT=file
MAIL_PREVIEW_DIR=tmp/mail

# Campaign creatives. `local` writes `{userId}/{file}` under this directory.
# Azure Blob is the same key space with a different STORAGE_DRIVER later.
STORAGE_DRIVER=local
CAMPAIGN_IMAGES_DIR=campaign-images

# Required when MAIL_TRANSPORT=smtp. e.g. smtp://user:pass@smtp.provider.com:587
# Gmail with an app password, for testing — note the %40 in the username, or the
# URL parser reads the wrong host:
#   smtps://you%40gmail.com:app-password@smtp.gmail.com:465
# `npm run mail:test -- you@example.com` proves it before a customer does.
# SMTP_URL=

MAIL_FROM=MoveAd <no-reply@movead.in>
# A customer replying to their welcome email should reach a person.
MAIL_REPLY_TO=support@movead.in

# ----------------------------------------------------------------- bootstrap
# Enables POST /v1/admin/bootstrap, the only way to create the first Super
# Admin. The endpoint is not mounted when this is unset, and refuses once any
# user exists. Unset it again after the first admin has been created.
ADMIN_BOOTSTRAP_TOKEN=local-bootstrap-token-change-me

# ------------------------------------------------------------------ shutdown
SHUTDOWN_TIMEOUT_MS=15000
