{
  "name": "movead-backend",
  "version": "0.1.0",
  "description": "MoveAd backend — verified-kilometre vehicle advertising platform. One codebase, three deployables: api, ingestion, worker.",
  "private": true,
  "type": "commonjs",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "npm run dev:api",
    "dev:api": "tsx watch src/entrypoints/api.ts",
    "dev:ingestion": "tsx watch src/entrypoints/ingestion.ts",
    "dev:worker": "tsx watch src/entrypoints/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start:api": "node dist/entrypoints/api.js",
    "start:ingestion": "node dist/entrypoints/ingestion.js",
    "start:worker": "node dist/entrypoints/worker.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,cjs,mjs,json,md,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,cjs,mjs,json,md,yml}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:migrate:status": "sequelize-cli db:migrate:status",
    "db:seed": "sequelize-cli db:seed:all",
    "db:create": "sequelize-cli db:create",
    "migration:new": "sequelize-cli migration:generate --name",
    "admin:first": "tsx scripts/first-admin.ts",
    "admin:create": "tsx scripts/create-admin.ts",
    "admin:reset": "tsx scripts/reset-accounts.ts",
    "admin:sessions": "tsx scripts/sessions.ts",
    "totp": "tsx scripts/totp.ts",
    "mail:preview": "tsx scripts/preview-mail.ts",
    "mail:test": "tsx scripts/send-test-mail.ts",
    "openapi:generate": "tsx scripts/generate-openapi.ts",
    "openapi:check": "tsx scripts/generate-openapi.ts --check",
    "verify": "npm run typecheck && npm run lint && npm run openapi:check && npm test"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@node-rs/argon2": "^2.1.0",
    "bullmq": "^6.1.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "http-terminator": "^3.2.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.5",
    "otplib": "^13.4.1",
    "pg": "^8.23.0",
    "pg-copy-streams": "^7.0.0",
    "pg-hstore": "^2.3.4",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "sequelize": "^6.37.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/pg-copy-streams": "^1.2.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "sequelize-cli": "^6.6.5",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@node-rs/argon2-wasm32-wasi": "^2.2.0"
  }
}
